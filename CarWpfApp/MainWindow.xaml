<Window x:Class="CarWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarWpfApp — Автомобіль + Повзунок"
        Height="620" Width="780"
        MinHeight="580" MinWidth="700"
        Background="#1E1E2E"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Стиль для заголовків секцій -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#CDD6F4"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Margin"       Value="0,0,0,6"/>
        </Style>

        <!-- Стиль для підписів полів -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#A6ADC8"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"       Value="0,0,8,0"/>
            <Setter Property="Width"        Value="110"/>
        </Style>

        <!-- Стиль для TextBox -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background"   Value="#313244"/>
            <Setter Property="Foreground"   Value="#CDD6F4"/>
            <Setter Property="BorderBrush"  Value="#585B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="6,4"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Height"       Value="28"/>
            <Setter Property="Width"        Value="160"/>
            <Setter Property="CaretBrush"   Value="#CDD6F4"/>
        </Style>

        <!-- Стиль для основних кнопок -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"   Value="#89B4FA"/>
            <Setter Property="Foreground"   Value="#1E1E2E"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="18,8"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B4BEFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#74C7EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"   Value="#A6ADC8"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════
             ЛІВА ПАНЕЛЬ — Зображення + Повзунок
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="#181825"
                CornerRadius="10"
                Padding="16">
            <StackPanel>

                <!-- Заголовок -->
                <TextBlock Text="📐 Розмір зображення"
                           Style="{StaticResource SectionHeader}"
                           FontSize="14"/>

                <!-- Зображення — розмір прив'язано до повзунка -->
                <Border Background="#313244"
                        CornerRadius="8"
                        Height="240"
                        Margin="0,0,0,12"
                        ClipToBounds="True">
                    <Image x:Name="CarImage"
                           Source="Assets/car.png"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="{Binding ElementName=SizeSlider, Path=Value}"
                           Height="{Binding ElementName=SizeSlider, Path=Value}"/>
                </Border>

                <!-- Поточний розмір -->
                <TextBlock x:Name="SizeLabel"
                           Text="Розмір: 150 × 150 px"
                           Foreground="#6C7086"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- Мітки Min / Max -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="50"  Foreground="#6C7086" FontSize="10"/>
                    <TextBlock Grid.Column="2" Text="300" Foreground="#6C7086" FontSize="10"/>
                </Grid>

                <!-- Повзунок -->
                <Slider x:Name="SizeSlider"
                        Width="150"
                        Minimum="50"
                        Maximum="300"
                        Value="150"
                        HorizontalAlignment="Center"
                        ValueChanged="SizeSlider_ValueChanged"
                        Foreground="#89B4FA"/>

                <TextBlock Text="← Перетягніть для зміни розміру →"
                           Foreground="#6C7086"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ПРАВА ПАНЕЛЬ — Форма Автомобіля
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Column="2"
                Background="#181825"
                CornerRadius="10"
                Padding="16">
            <StackPanel>

                <!-- Заголовок -->
                <TextBlock Text="🚗 Параметри автомобіля"
                           Style="{StaticResource SectionHeader}"
                           FontSize="14"
                           Margin="0,0,0,12"/>

                <!-- Марка -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Марка:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="BrandBox"
                             Style="{StaticResource InputBox}"
                             Text="Toyota"/>
                </StackPanel>

                <!-- Модель -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Модель:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ModelBox"
                             Style="{StaticResource InputBox}"
                             Text="Camry"/>
                </StackPanel>

                <!-- Рік -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Рік випуску:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="YearBox"
                             Style="{StaticResource InputBox}"
                             Text="2024"/>
                </StackPanel>

                <!-- Макс. швидкість -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Макс. швидкість:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SpeedBox"
                             Style="{StaticResource InputBox}"
                             Text="210"/>
                </StackPanel>

                <!-- Колір -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Колір:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ColorBox"
                             Style="{StaticResource InputBox}"
                             Text="Срібний"/>
                </StackPanel>

                <!-- Чекбокс — наявність дисплея -->
                <CheckBox x:Name="DisplayCheckBox"
                          Content="Підключити дисплей (делегат активний)"
                          IsChecked="True"
                          Margin="0,0,0,12"/>

                <!-- Кнопка Створити -->
                <Button Content="🚗 Створити автомобіль"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        Click="CreateCarButton_Click"
                        Margin="0,0,0,14"/>

                <!-- Дисплей — виведення інформації через делегат -->
                <TextBlock Text="📺 Дисплей автомобіля:"
                           Foreground="#A6ADC8"
                           FontSize="11"
                           Margin="0,0,0,4"/>

                <Border Background="#11111B"
                        CornerRadius="6"
                        BorderBrush="#313244"
                        BorderThickness="1"
                        Height="160">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="DisplayOutput"
                                 Background="Transparent"
                                 Foreground="#A6E3A1"
                                 FontFamily="Cascadia Code, Consolas, Courier New"
                                 FontSize="11"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Padding="10"
                                 Text="Тут з'явиться інформація після натискання кнопки..."/>
                    </ScrollViewer>
                </Border>

                <!-- Статусний рядок -->
                <TextBlock x:Name="StatusLabel"
                           Text=""
                           Foreground="#F38BA8"
                           FontSize="11"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
